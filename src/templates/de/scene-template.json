    "Perspektive": {
      "type": "link",
      "targetTypes": ["character"]
    },
    "Hauptschauplatz": {
      "type": "link",
      "targetTypes": ["place"]
    },
    "Beteiligte Figuren": {
      "type": "multilink",
      "targetTypes": ["character"]
    },
    "Wortziel": {
      "type": "number"
    }
  },
  "contextFields": [
    "Kapitel",
    "Perspektive",
    "Hauptschauplatz",
    "Beteiligte Figuren"
  ],
  "defaultTags": [
    "scene"
  ],
  "defaultContent": "## Überblick\n\n## Szenenfunktion\n\n## Ausgangslage\n\n## Ziel der Figur\n\n## Konflikt\n\n## Szenenablauf\n\n## Ergebnis & Folgen\n\n## Kontinuität\n\n## Offene Fragen\n\n## Manuskript"
